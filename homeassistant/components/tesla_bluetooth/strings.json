{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Discovered vehicles",
        "description": "If nothing is discovered, ensure you are within Bluetooth range, and ensure your vehicle has less than three active BLE connections (Tesla apps, Watch apps, Powerwalls with Charge On Solar).",
        "data": {
          "address": "Vehicles"
        }
      },
      "vin": {
        "title": "Enter VIN",
        "description": "The Vehicle Identification Number is required for the Tesla Command Protocol. You can find your VIN in your vehicle service screen or at the bottom of the Tesla app",
        "data": {
          "vin": "VIN"
        }
      },
      "instructions": {
        "title": "Authorize key",
        "description": "After clicking submit, place your keycard on the reader inside your vehicle until you get a prompt to authorize the key on the screen. You may want to go into keys (in settings) to rename the key after authorizing it."
      }
    },
    "abort": {
      "no_devices_found": "[%key:common::config_flow::abort::no_devices_found%]",
